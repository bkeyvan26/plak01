<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>K1Plak</title><link href="/static/style.css" rel="stylesheet"></head><body>

<main class="auth-page"><div class="card auth-card"><div class="logo">K1Plak</div><p class="muted">سامانه هوشمند پلاک‌خوان</p><form method="post"><label>نام کاربری</label><input class="form-control" name="username" placeholder="admin" required><label>رمز عبور</label><input class="form-control" type="password" name="password" placeholder="••••••••" required><button class="btn w-100" type="submit">ورود به سامانه</button></form></div></main></body></html>